# RALLY Backend Environment Configuration
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Required: Live Supabase Project Credentials (Postgres persistence and Auth verification)
# The Service Role Key stays strictly on the server and must never be exposed to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional settings
RALLY_MODE=supabase
URGENT_ESCALATION_MINUTES=15
ESCALATION_INTERVAL_MS=60000
