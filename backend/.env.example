# Demo is device-local, persisted in backend/data/demo.json. Never expose demo on a public server.
RALLY_MODE=demo
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
# For live Supabase mode, set RALLY_MODE=supabase. This key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: RALLY_DATA_FILE=/absolute/path/to/demo.json
# Optional: RALLY_SEED_DATE=2026-10-01T06:00:00Z
