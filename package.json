{
  "name": "rally", "version": "1.0.0", "private": true, "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "lint": "eslint frontend/src backend/src shared tests scripts",
    "seed": "node scripts/seed-demo.mjs",
    "worker": "node backend/src/worker.js"
  },
  "devDependencies": {"concurrently": "^9.2.1", "eslint": "^9.39.0", "@eslint/js": "^9.39.0", "eslint-plugin-react-hooks": "^7.0.1", "globals": "^16.5.0", "@electric-sql/pglite": "^0.3.10", "playwright": "^1.56.0"}
}
